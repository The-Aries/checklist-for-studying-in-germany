  "stages": [
    {
      "id": "aps",
      "title": "APS 审核",
      "appliesTo": "适用于已取得中国大陆普通高校本科学历、计划赴德国攻读硕士，并走 APS 一般国内申请人程序的申请人。",
      "lastUpdated": "2026-09-19",
      "lastVerified": "2026-09-19",
      "intro": [
        "本科已经毕业的申请人当前继续参加 APS 面谈审核；本页不按本科在读生的 TestAS 路径设计。",
        "如果你有交换学习、转专业、专升本、更高一级学历或延期毕业等经历，本清单不足以覆盖你的补充材料，请同时查看 APS 官方“特殊情况另须补充材料”。"
      ],
      "groups": [
        {
          "id": "process",
          "title": "办理步骤与材料",
          "items": [
            {
              "id": "aps-register",
              "title": "在线注册",
              "description": "在 APS 官网选择“一般国内申请人审核程序”完成注册，信息必须完整真实。",
              "sources": [
                "APS-001",
                "APS-002"
              ],
              "sourceLocation": "",
              "progress": true,
              "condition": null
            },
            {
              "id": "aps-pay-fee",
              "title": "支付审核费",
              "description": "当前一般国内申请人审核费为人民币 2500 元，按 APS 官方汇款要求支付并保存汇款凭证。",
              "sources": [
                "APS-001",
                "APS-003"
              ],
              "sourceLocation": "",
              "progress": true,
              "condition": null
            },
            {
              "id": "aps-mail-package",
              "title": "邮寄完整材料",
              "description": "本科毕业生走面谈审核；上海辖区（江苏、安徽、浙江、上海）按官方要求寄上海审核部，其它辖区寄北京审核部。",
              "sources": [
                "APS-001",
                "APS-006",
                "APS-007"
              ],
              "sourceLocation": "",
              "progress": true,
              "condition": null
            },
            {
              "id": "aps-monitor-review",
              "title": "关注审核状态",
              "description": "APS 收到材料后约 10 天给出档案号；持续查看注册邮箱及 APS 账号，按系统通知补交材料。",
              "sources": [
                "APS-001"
              ],
              "sourceLocation": "",
              "progress": true,
              "condition": null
            },
            {
              "id": "aps-interview",
              "title": "参加 APS 面谈",
              "description": "材料审核通过后按系统邮件通知参加面谈；面谈含约 20 分钟书面准备和最长约 25 分钟口头部分，可使用英语和/或德语。",
              "sources": [
                "APS-001",
                "APS-004",
                "APS-007"
              ],
              "sourceLocation": "",
              "progress": true,
              "condition": null
            },
            {
              "id": "aps-download-digzert",
              "title": "下载 DigZert",
              "description": "审核通过后在 APS 个人账号下载数字签名审核证书 DigZert，后续高校申请和签证使用。",
              "sources": [
                "APS-001",
                "APS-002"
              ],
              "sourceLocation": "",
              "progress": true,
              "condition": null
            }
          ]
        },
        {
          "id": "documents",
          "title": "材料清单",
          "items": [
            {
              "id": "aps-registration-proof",
              "title": "在线注册证明",
              "description": "打印注册证明，贴 6 个月内 2 寸证件照，亲笔签名并写明签字地点和日期。",
              "sources": [
                "APS-001"
              ],
              "sourceLocation": "p. 3",
              "progress": true,
              "condition": null
            },
            {
              "id": "aps-transfer-proof",
              "title": "汇款单复印件",
              "description": "应清楚显示汇款人、金额、时间、汇出银行和申请人姓名等信息。",
              "sources": [
                "APS-001"
              ],
              "sourceLocation": "p. 3",
              "progress": true,
              "condition": null
            },
            {
              "id": "aps-id-passport",
              "title": "身份证 / 护照复印件",
              "description": "提交身份证正反面复印件；如已有护照，同时提交护照复印件。",
              "sources": [
                "APS-001"
              ],
              "sourceLocation": "p. 3",
              "progress": true,
              "condition": null
            },
            {
              "id": "aps-admission-roster",
              "title": "大学录取花名册",
              "description": "提交高校招生办或档案馆出具的中英双语密封件，或中英翻译公证件；大学录取通知书不能替代。",
              "sources": [
                "APS-001"
              ],
              "sourceLocation": "p. 3",
              "progress": true,
              "condition": null
            },
            {
              "id": "aps-transcript",
              "title": "大学成绩单",
              "description": "提交中英双语密封件或中英翻译公证件；成绩单按学期排列并包含全部课程，包括未通过课程。",
              "sources": [
                "APS-001"
              ],
              "sourceLocation": "p. 3",
              "progress": true,
              "condition": null
            },
            {
              "id": "aps-language-proof",
              "title": "德语 / 英语水平证明",
              "description": "提交德语和/或英语语言水平证明复印件；没有相应证明时按官方要求提供自学学时说明。",
              "sources": [
                "APS-001"
              ],
              "sourceLocation": "p. 3",
              "progress": true,
              "condition": null
            },
            {
              "id": "aps-degree-docs",
              "title": "本科毕业证和学位证",
              "description": "提交毕业证书及学位证书的中英双语密封件或中英翻译公证件。",
              "sources": [
                "APS-001"
              ],
              "sourceLocation": "p. 3",
              "progress": true,
              "condition": null
            },
            {
              "id": "aps-postgrad-cv",
              "title": "毕业后表格式简历",
              "description": "本科毕业超过一年时，提交德文或英文表格式简历，按时间段说明毕业后的经历。",
              "sources": [
                "APS-001"
              ],
              "sourceLocation": "p. 3",
              "progress": true,
              "condition": {
                "field": "graduationAge",
                "equals": "over-one-year"
              }
            }
          ]
        }
      ],
      "references": [
        "APS-001",
        "APS-002",
        "APS-003",
        "APS-004",
        "APS-006",
        "APS-007"
      ],
      "notes": [
        {
          "title": "双语密封件",
          "text": "由学校出具，包含中英文材料原件并加盖学校公章，信封封口同样需学校盖章且不得自行拆封；只有院系级盖章无效。学校不能提供时，可按 APS 说明改交中英翻译公证件。",
          "sources": [
            "APS-001"
          ]
        },
        {
          "title": "成绩单",
          "text": "应由教务处或档案馆出具，按学期排列并包含全部课程及结果；辅修/双学位成绩与主修专业分开开具。",
          "sources": [
            "APS-001"
          ]
        }
      ]
    },
    {
      "id": "visa",
      "title": "德国留学签证",
      "appliesTo": "适用于已经取得德国高校硕士专业录取、准备按照《居留法》第 16b 条申请普通留学签证的本项目目标用户。",
      "lastUpdated": "2026-09-19",
      "lastVerified": "2026-09-19",
      "intro": [
        "本页不覆盖“留学申请人签证”、纯语言班、博士、交换项目等其它居留目的。",
        "德国驻华使领馆现行留学页面写明：正常处理时间约 2–4 周，个别情况更长；最早可在计划出行前 6 个月递交。处理时间不是承诺，应尽早准备。"
      ],
      "groups": [
        {
          "id": "process",
          "title": "办理步骤与材料",
          "items": [
            {
              "id": "visa-confirm-jurisdiction",
              "title": "确认递签地点与预约方式",
              "description": "递交地点按当前常住地和官方辖区规则确定；北京/上海等辖区的 APS 申请人可能通过 APS 递签，其它辖区按领馆规则办理。",
              "sources": [
                "APS-005",
                "VISA-003",
                "VISA-004"
              ],
              "sourceLocation": "",
              "progress": true,
              "condition": null
            },
            {
              "id": "visa-book-appointment",
              "title": "预约递签",
              "description": "按主管机构的当前在线预约/等候名单规则预约，长期签证原则上需要本人递交。",
              "sources": [
                "VISA-001",
                "VISA-003",
                "VISA-004"
              ],
              "sourceLocation": "",
              "progress": true,
              "condition": null
            },
            {
              "id": "visa-prepare-copy-set",
              "title": "按要求整理材料",
              "description": "携带材料原件和一套复印件；复印件单面、按官方顺序整理，不订书或粘贴；中文材料附德文译文，英文材料无需再译德文。",
              "sources": [
                "VISA-001",
                "VISA-002",
                "VISA-003",
                "VISA-004"
              ],
              "sourceLocation": "",
              "progress": true,
              "condition": null
            },
            {
              "id": "visa-videx",
              "title": "VIDEX 申请表",
              "description": "使用官方 VIDEX 用德语或英语完整填写，打印后亲笔签名。",
              "sources": [
                "VISA-001",
                "VISA-002"
              ],
              "sourceLocation": "",
              "progress": true,
              "condition": null,
              "links": [
                {
                  "label": "打开官方 VIDEX",
                  "url": "https://videx.diplo.de/videx/visum-erfassung/videx-langfristiger-aufenthalt"
                }
              ]
            },
            {
              "id": "visa-section54",
              "title": "《居留法》第 54 条告知书",
              "description": "打印官方告知书，阅读后亲笔签名。",
              "sources": [
                "VISA-001",
                "VISA-002"
              ],
              "sourceLocation": "",
              "progress": true,
              "condition": null,
              "links": [
                {
                  "label": "下载官方告知书",
                  "url": "https://china.diplo.de/resource/blob/2561252/5e9cccec777a2ca0b7aaa019dcd6f670/belehrung-zum-visumantrag-data.pdf"
                }
              ]
            },
            {
              "id": "visa-biometric-photos",
              "title": "生物识别证件照",
              "description": "准备 2 张近期生物识别照片，不接受精修照片或 6 个月前的照片。",
              "sources": [
                "VISA-001",
                "VISA-002"
              ],
              "sourceLocation": "",
              "progress": true,
              "condition": null
            },
            {
              "id": "visa-passport",
              "title": "护照及相关页面复印件",
              "description": "护照自签证签发之日起应仍有一年以上有效期且至少有两页完全空白页；携带原件及信息页、签证和出入境印章页复印件。",
              "sources": [
                "VISA-001"
              ],
              "sourceLocation": "",
              "progress": true,
              "condition": null
            },
            {
